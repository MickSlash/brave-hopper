FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 1000 streamcdn && useradd -u 1000 -g streamcdn -s /bin/false -m streamcdn
RUN mkdir -p /var/lib/stream-control /etc/stream-cdn && chown -R streamcdn:streamcdn /var/lib/stream-control /etc/stream-cdn
COPY target/release/stream-control /usr/local/bin/stream-control
COPY configs/control.toml /etc/stream-cdn/control.toml
USER streamcdn
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/stream-control", "--config", "/etc/stream-cdn/control.toml"]
